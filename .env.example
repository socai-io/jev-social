# Jev on OpenRouter. The lowercase `openrouter=` form is also accepted.
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
# Optional evidence-report synthesis model. Set to `off` for deterministic reports.
OPENROUTER_REPORT_MODEL=openai/gpt-4o-mini

# Optional local TypeSafe-compatible decision endpoint, for example Kev.
# When set, routing does not require or forward an OpenRouter key.
# JEV_SOCIAL_SYSTEM_ONE_URL=http://127.0.0.1:8009/v1/systemone
# JEV_SOCIAL_SYSTEM_ONE_MODEL=kev-latest
# JEV_SOCIAL_SYSTEM_ONE_TIMEOUT_MS=120000

# Optional path to a local or development socai binary.
SOCAI_BIN=

# Optional browser routing. Existing is socai's default; use a CDP endpoint
# when connecting to a remote or tunneled DeepTensor browser.
# SOCAI_CHROME_PROFILE=existing
# SOCAI_CDP_WS=wss://your-browser-websocket

# Optional isolated state directory. Defaults to ~/.jev-social.
JEV_SOCIAL_HOME=
